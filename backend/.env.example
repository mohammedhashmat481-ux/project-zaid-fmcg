# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL Database Configuration
# Format: postgresql://username:password@localhost:5432/database_name
# If unset locally, the application seamlessly defaults to embedded local PostgreSQL (PGlite).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inkcrm

# Initial Super Admin Provisioning (Auto-Seeder)
# In production, set these to securely create the first Super Admin without hardcoding credentials.
ADMIN_EMAIL=admin@crm.com
ADMIN_PASSWORD=change_this_to_a_secure_password_in_production

# Optional Organization Customization
ORG_NAME=inkSales Enterprises
ORG_SUBDOMAIN=sales

# Security & Authentication
JWT_SECRET=super_secret_jwt_access_token_key_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_54321
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=super_secret_face_encryption_key_32_bytes_long_1234

# SMTP/Email Configuration (Optional for notifications/verification)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@inkcrm.com

# S3 Compatible Storage (Optional, defaults to local folder storage)
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=inkcrm-documents
